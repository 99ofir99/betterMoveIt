# Copy to `.env` (git-ignored). Loaded by server/src/env.js; real env vars win.

# API port (Vite proxies /api → 127.0.0.1:8787, so change both if you move it)
# PORT=8787

# Binary transit store to load. Default lookup: data/gtfs-dist, then data/gtfs-sample.
# GTFS_DATA_DIR=./data/gtfs-dist

# Live data — Ministry of Transport SIRI key (enables live departures + vehicles)
# MOT_KEY=
# MOT_SIRI_URL=
# MOT_VEHICLE_CACHE_MS=8000

# Live vehicles fallback — Hasadna Open Bus Stride (no key needed)
# HASADNA_VEHICLE_URL=
# HASADNA_FRESH_MINUTES=10
# HASADNA_VEHICLE_LIMIT=2000
# HASADNA_CACHE_MS=8000
# HASADNA_TIMEOUT_MS=10000

# tools/prepare-data.mjs sources (npm run data)
# Keep only trips running in the next N days (smaller store, less RAM). Unset = whole feed.
# INGEST_DAYS=7

# Prebuilt gtfs-dist.tgz to download instead of ingesting the raw feed
# GTFS_DIST_URL=
# GTFS_ZIP_URL=https://gtfs.mot.gov.il/gtfsfiles/israel-public-transportation.zip

# Vite: serve the PWA service worker in dev (normally off)
# PWA_DEV=1
