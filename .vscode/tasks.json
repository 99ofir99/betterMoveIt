{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite",
      "detail": "Vite dev server on :5173 (proxies /api to :8787)",
      "type": "npm",
      "script": "dev:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(x)(x)(x)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activatesBeforeEnd": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "dev (API + web)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "verify (typecheck + tests + build)",
      "type": "npm",
      "script": "verify",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "smoke (boot API, hit every endpoint)",
      "type": "npm",
      "script": "smoke",
      "problemMatcher": []
    }
  ]
}
